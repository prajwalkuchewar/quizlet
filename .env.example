# Copy to .env on the VPS (next to docker-compose.yml) and fill in real values. Never commit the filled-in file.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
# Public origin(s) of the web client, comma-separated, e.g. http://your-vps-ip
CORS_ORIGINS=http://localhost
# Set by the deploy workflow, or set manually: lowercase GitHub owner name.
GHCR_OWNER=
IMAGE_TAG=latest
