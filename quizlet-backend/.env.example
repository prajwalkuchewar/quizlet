DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/quizlet
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_CHAT_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Embeddings use a local all-MiniLM-L6-v2 model (384 dims, no key, no cost).
EMBEDDING_PROVIDER=local
LLM_RETRY_ATTEMPTS=2
MATERIAL_CHUNK_CHARS=1200
MATERIAL_CHUNK_OVERLAP=180
MATERIAL_MAX_UPLOAD_BYTES=10000000

